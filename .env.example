# Copia este archivo como .env y completa los valores.

# Clave de la API de Claude (https://platform.claude.com)
ANTHROPIC_API_KEY=sk-ant-...

# Tu zona horaria (formato IANA)
ZONA_HORARIA=America/Mexico_City

# Tu horario de trabajo / día productivo
HORA_INICIO=08:00
HORA_FIN=20:00

# Nombre del calendario donde se crearán los bloques de enfoque ("primary" = tu calendario principal)
CALENDARIO_ID=primary
